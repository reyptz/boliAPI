# ── Base de données ──────────────────────────────────────────
# Dev local (SQLite async)
# DATABASE_URL=sqlite+aiosqlite:///./boli_dev.db
# Production (PostgreSQL — utilisé automatiquement par docker-compose)
DATABASE_URL=postgresql+asyncpg://boli_user:boli_password@localhost:5433/boli_db

# ── JWT ──────────────────────────────────────────────────────
# IMPORTANT : Générer un secret unique en production !
# Exécuter : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis & RabbitMQ ────────────────────────────────────
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://boli_user:boli_password@localhost:5672/

# ── Mobile Money (paiements) ────────────────────────────────
# En dev : mock://mobilemoney. En prod : URL réelle du fournisseur.
MOBILE_MONEY_API_URL=mock://mobilemoney
MOBILE_MONEY_API_KEY=test_key
# Secret partagé pour vérifier la signature HMAC-SHA256 des webhooks de paiement.
# OBLIGATOIRE en production (sinon les confirmations de paiement sont rejetées).
PAYMENT_WEBHOOK_SECRET=

# ── Application ─────────────────────────────────────────────
APP_NAME=BoliAPI
APP_VERSION=1.0.0
DEBUG=false

# ── CORS ────────────────────────────────────────────────────
# Origines autorisées (liste blanche séparée par des virgules).
# Ne JAMAIS utiliser "*" avec des credentials.
CORS_ORIGINS=https://boli.ml,https://www.boli.ml,http://localhost:3000

# ── Firebase (sync SuguJate → Boli marketplace) ─────────────
# Chemin vers le fichier google-services.json / service-account
FIREBASE_CREDENTIALS_PATH=./google-services.json
FIREBASE_PROJECT_ID=store-app-d442f
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=300

# ── Docker Compose (variables optionnelles) ─────────────────
POSTGRES_PASSWORD=boli_password
API_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT=6379
RABBITMQ_PASSWORD=boli_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
