# ── Base de données ──────────────────────────────────────────
# Dev local (SQLite async)
DATABASE_URL=sqlite+aiosqlite:///./boli_dev.db
# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://boli:boli@localhost:5432/boli_db

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ─────────────────────────────────────────────
APP_NAME=BoliAPI
APP_VERSION=0.1.0
DEBUG=true
